<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <uses-feature android:name="android.software.leanback" android:required="true"/>
 <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
 <application android:label="mero-stream" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false" android:usesCleartextTraffic="false" android:hardwareAccelerated="true">
  <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/><category android:name="android.intent.category.LEANBACK_LAUNCHER"/></intent-filter>
  </activity>
 </application>
</manifest>
